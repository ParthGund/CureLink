# Server Configuration
PORT=5000
NODE_ENV=development

# Database Configuration
MONGO_URI=mongodb://localhost:27017/curelink

# Authentication
JWT_SECRET=your_jwt_secret_here
JWT_EXPIRE=7d

# Client URL (for CORS)
CLIENT_URL=http://localhost:5173

# Clinic timezone offset from UTC for the missed-appointment sweeper (optional)
# Accepts +05:30, 330 (minutes) or 5.5 (hours). Defaults to UTC.
CLINIC_TZ_OFFSET=+05:30
